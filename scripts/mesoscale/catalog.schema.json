{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GFC mesoscale cycle catalog v1",
  "type": "object",
  "required": ["schemaVersion", "model", "cycleTime", "status", "receivedAt", "processedAt", "ageMinutes", "processingVersion", "domain", "frames"],
  "properties": {
    "schemaVersion": {"const": 1},
    "model": {"type": "object", "required": ["id", "name"], "properties": {"id": {"enum": ["hrrr", "rap", "rrfs"]}, "name": {"type": "string"}}},
    "cycleTime": {"type": "string", "format": "date-time"},
    "status": {"enum": ["complete", "partial", "failed"]},
    "receivedAt": {"type": "string", "format": "date-time"},
    "processedAt": {"type": "string", "format": "date-time"},
    "ageMinutes": {"type": "integer", "minimum": 0},
    "processingVersion": {"type": "string"},
    "domain": {"type": "object", "required": ["id", "name", "projection", "bounds", "minZoom", "maxZoom"]},
    "frames": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["forecastHour", "validTime", "frameType", "status", "parameters"], "properties": {"forecastHour": {"type": "integer", "minimum": 0}, "validTime": {"type": "string", "format": "date-time"}, "frameType": {"enum": ["analysis", "forecast"]}, "status": {"enum": ["complete", "partial", "failed"]}, "parameters": {"type": "array", "items": {"type": "object", "required": ["id", "displayName", "units", "level", "legend", "displayType", "data", "source", "receivedAt", "processedAt", "ageMinutes", "processingVersion", "status"], "properties": {"id": {"type": "string"}, "displayType": {"const": "raster"}, "data": {"type": "object", "required": ["type", "urlTemplate", "format", "projection", "minZoom", "maxZoom"], "properties": {"type": {"const": "xyz-raster"}, "urlTemplate": {"type": "string", "pattern": "\\{z\\}.*\\{x\\}.*\\{y\\}"}, "format": {"const": "image/png"}}}, "status": {"enum": ["complete", "partial", "failed"]}}}}}}}
  },
  "additionalProperties": true
}
