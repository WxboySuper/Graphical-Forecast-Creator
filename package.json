{
  "name": "graphical-forecast-creator",
  "version": "3.0.0-beta.3",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "minimatch@>=7 <11": "^11.0.5",
      "@grpc/grpc-js@<1.13.6": "^1.14.7",
      "glob@>=9 <14": "^14.0.4",
      "fast-uri": "^3.1.6",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.0",
      "brace-expansion@2": "^2.1.2",
      "brace-expansion@5": "^5.0.9",
      "brace-expansion@1": "^1.1.18",
      "gaxios>uuid": "11.1.1",
      "@modelcontextprotocol/sdk": "^1.30.0",
      "@hono/node-server": "^2.0.5",
      "@google-cloud/pubsub>@opentelemetry/core": "^2.8.0",
      "undici@6": "^6.28.0",
      "undici@8": "^8.9.0",
      "ip-address": "^10.3.1",
      "re2": "^1.26.1",
      "qs": "^6.16.0",
      "browserslist": "^4.28.7"
    }
  },
  "engines": {
    "node": ">=22.22.0 <23 || >=24.11.0 <25 || >=26 <27"
  },
  "dependencies": {
    "@clerk/backend": "^3.31.3",
    "@clerk/react": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@reduxjs/toolkit": "^2.15.0",
    "@sentry/react": "^11.16.0",
    "@turf/turf": "^7.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.4.0",
    "html2canvas": "^1.4.1",
    "immer": "^11.2.10",
    "jszip": "^3.10.2",
    "lucide-react": "^1.77.0",
    "ol": "^10.11.0",
    "ol-mapbox-style": "^13.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router": "~8.5.2",
    "redux": "^5.0.1",
    "tailwind-merge": "^3.7.1",
    "uuid": "^14.0.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:test": "node scripts/check-test-types.mjs",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "marketing:build": "node scripts/marketing/build.mjs",
    "lint:fix": "eslint . --fix",
    "docs:inventory": "node scripts/generate-repository-inventory.mjs",
    "docs:site": "node scripts/build-local-docs.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/check-third-party-licenses.mjs",
    "test": "jest && node --test \"cloudflare/*.test.mjs\"",
    "test:cloudflare": "node --test \"cloudflare/*.test.mjs\"",
    "test:toolbar:timezone": "cross-env TZ=America/New_York jest src/components/IntegratedToolbar/IntegratedToolbar.test.tsx",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:beta-worker": "node --test cloudflare/beta-worker.test.mjs cloudflare/beta-clerk-d1-worker.test.mjs",
    "test:coverage": "jest --coverage",
    "perf": "cross-env GFC_PERF=1 jest --runInBand src/performance",
    "test:firestore-rules": "pnpm exec firebase emulators:exec --only firestore --project gfc-rules-test \"node --test tests/firestore.rules.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "flags": "node scripts/flags.mjs",
    "branches:report": "cross-env DRY_RUN=1 node scripts/generate-stale-branch-report.mjs",
    "predeploy": "pnpm run build",
    "deploy": "gh-pages -d build",
    "prebuild": "pnpm run css:build",
    "css:build": "tailwindcss -i ./src/tailwind.input.css -o ./src/tailwind.generated.css",
    "css:watch": "tailwindcss -i ./src/tailwind.input.css -o ./src/tailwind.generated.css --watch",
    "marketing:preview": "node scripts/marketing/preview.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/parser": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@sentry/vite-plugin": "^11.16.0",
    "@tailwindcss/cli": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "babel-jest": "^30.5.2",
    "babel-plugin-istanbul": "^8.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "firebase-tools": "15.37.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "maplibre-gl": "6.19.0",
    "marked": "18.2.1",
    "postcss": "8.5.33",
    "rollup": ">=4.68.7",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "yaml": "2.9.1"
  }
}
