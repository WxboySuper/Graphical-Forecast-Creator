{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "gfc-mesoscale-scheduler",
  "main": "./mesoscale-scheduler.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["12,42 * * * *", "32 * * * *", "23 3,9,15,21 * * *"]
  },
  "vars": {
    "GITHUB_REPOSITORY": "WxboySuper/Graphical-Forecast-Creator",
    "WORKFLOW_REF": "main"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
