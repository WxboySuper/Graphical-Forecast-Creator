{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "gfc-beta",
  "account_id": "3488c751e28fdbb1b31d95deac5e6cfd",
  "main": "./beta-worker.mjs",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "routes": [
    { "pattern": "beta.gfcweather.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gfc-beta",
      "database_id": "SET_AFTER_CREATING_BETA_D1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FIRESTORE_SNAPSHOT", "bucket_name": "gfc-beta-firestore-migration-snapshot" }
  ],
  "vars": { "BETA_AUTH_BACKEND": "clerk-d1" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
