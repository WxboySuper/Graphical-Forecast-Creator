{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "gfc-feedback",
  "account_id": "3488c751e28fdbb1b31d95deac5e6cfd",
  "main": "./feedback-worker.mjs",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "routes": [{ "pattern": "feedback.gfcweather.com", "custom_domain": true }],
  "d1_databases": [{ "binding": "FEEDBACK_DB", "database_name": "gfc-feedback", "database_id": "fee363b4-0a32-41a4-887c-2ec7e917e0b0", "migrations_dir": "./feedback/migrations" }],
  "vars": {
    "FIREBASE_PROJECT_ID": "graphical-forecast-creator",
    "CF_ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    "CF_ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "FEEDBACK_ALLOWED_ORIGINS": "https://beta.gfcweather.com,https://app.gfcweather.com,https://gfcweather.com,https://gfc.weatherboysuper.com,http://localhost:3000,http://localhost:5173"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
